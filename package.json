{
  "name": "workflow-repo",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "prepare": "husky install",
    "start": "live-server --port=5500",
    "format": "prettier --write .",
    "test:unit": "npx vitest run tests",
    "test:playwright": "npx playwright test",
    "test:playwright:headed": "npx playwright test --headed",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.8.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.0",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.4",
    "live-server": "^1.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.12",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.html": [
      "prettier --write"
    ]
  }
}
